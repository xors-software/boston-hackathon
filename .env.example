# ----- Frontend (web/) -----
NEXT_PUBLIC_ENVIRONMENT=PRODUCTION
NEXT_PUBLIC_CHAIN_ID='1'
NEXT_PUBLIC_SEGMENT_WRITE_KEY='SEGMENT WRITE KEY HERE'

# Where /api/* rewrites to (Next.js → Elysia).
API_URL=http://localhost:3001

# Cross-origin override. Leave UNSET for normal deploys — same-origin
# proxying via /api keeps xors_session cookie under SameSite=Lax.
# NEXT_PUBLIC_API_URL=

# XORS centralized identity (api.xors.xyz). Required — without these
# /oauth fails with oauth_decrypt. Shared across all XORS consumer apps.
API_AES_KEY=
API_IV_KEY=

# Optional. Override to point at a local api.xors.xyz dev instance.
# XORS_API_URL=

# Registered in apis/common/constants.ts.
NEXT_PUBLIC_XORS_OAUTH_DOMAIN=REDIRECT_BOSTON
XORS_AUTH_SOURCE=boston-hackathon.local

# ----- Backend (server/) -----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Set to "false" only for local dev (http://localhost rejects Secure cookies).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax

# OpenAI Whisper for /transcribe (voice → text on recipient + AI screens)
OPENAI_API_KEY=sk-...

# Anthropic Claude for /ai/* (recipient + why AI conversations + summarize)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres for /gifts (Railway provides DATABASE_URL — set in service env).
DATABASE_URL=postgresql://user:pass@localhost:5432/ember

# S3-compatible photo storage (Railway bucket / R2 / AWS S3 — same SDK).
# Endpoint format: https://<host>. Region "auto" for R2 / Railway.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Disk-backed storage fallback for local dev / e2e where standing up S3 is
# overkill. When set, photo + voice uploads write here and skip S3 entirely.
# Leave UNSET in prod.
# PHOTO_STORAGE_LOCAL_DIR=/tmp/ember-photos

# Local-dev / e2e bypass. When set, every request is authenticated as this
# user (no XORS cookie required). Leave UNSET in prod.
# TEST_USER_EMAIL=test@example.com
