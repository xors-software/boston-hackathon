# =============================================================================
# Boston-hackathon env vars
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (web/) — Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT=PRODUCTION
NEXT_PUBLIC_CHAIN_ID='1'
NEXT_PUBLIC_SEGMENT_WRITE_KEY='SEGMENT WRITE KEY HERE'

# Where the Next.js /api/* rewrite proxies to. Default points at the
# local Elysia dev server. In production this is your deployed API URL.
API_URL=http://localhost:3001

# Cross-origin override. Leave UNSET in normal setups — same-origin
# proxying through /api is what keeps the xors_session cookie under
# SameSite=Lax. Only set this for mobile clients or alternate deploys
# that bypass the Next.js rewrite.
# NEXT_PUBLIC_API_URL=

# XORS centralized identity (api.xors.xyz). API_AES_KEY + API_IV_KEY
# are shared with every other XORS consumer app — ask whoever owns
# the apis/ repo for the current values. Without these the /oauth
# callback can't decrypt session keys handed out by api.xors.xyz, so
# every sign-in fails with `oauth_decrypt`.
API_AES_KEY=
API_IV_KEY=

# Optional. Defaults to https://api.xors.xyz. Override for local
# api.xors.xyz development.
# XORS_API_URL=

# Domain key registered in apis/common/constants.ts (REDIRECT_OPTIONS).
# api.xors.xyz uses this to decide where to bounce the user after
# Google consent. Register your own key in the apis repo before
# pointing this at production.
NEXT_PUBLIC_XORS_OAUTH_DOMAIN=REDIRECT_BOSTON

# Tag api.xors.xyz uses to track which apps a user has signed into.
# Match the consumer app's deployed domain.
XORS_AUTH_SOURCE=boston-hackathon.local

# -----------------------------------------------------------------------------
# Backend (server/) — Elysia/Bun
# -----------------------------------------------------------------------------
PORT=3001

# Comma-separated list of allowed web origins. Must match exactly
# (no trailing slash). Wildcards supported via trailing '*'.
CORS_ORIGIN=http://localhost:3000

# Cookie hardening. Keep `true` for any HTTPS deploy. Set to "false"
# only for local dev (http://localhost rejects Secure cookies).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax

# Same shared crypto bytes as the frontend — the server reads these
# only to log boot status; the actual decrypt happens in web/app/oauth.
# API_AES_KEY=
# API_IV_KEY=
# XORS_API_URL=
