# ----- Frontend (web/) -----
NEXT_PUBLIC_ENVIRONMENT=PRODUCTION
NEXT_PUBLIC_CHAIN_ID='1'
NEXT_PUBLIC_SEGMENT_WRITE_KEY='SEGMENT WRITE KEY HERE'

# Where /api/* rewrites to (Next.js → Elysia).
API_URL=http://localhost:3001

# Cross-origin override. Leave UNSET for normal deploys — same-origin
# proxying via /api keeps xors_session cookie under SameSite=Lax.
# NEXT_PUBLIC_API_URL=

# XORS centralized identity (api.xors.xyz). Required — without these
# /oauth fails with oauth_decrypt. Shared across all XORS consumer apps.
API_AES_KEY=
API_IV_KEY=

# Optional. Override to point at a local api.xors.xyz dev instance.
# XORS_API_URL=

# Registered in apis/common/constants.ts.
NEXT_PUBLIC_XORS_OAUTH_DOMAIN=REDIRECT_BOSTON
XORS_AUTH_SOURCE=boston-hackathon.local

# ----- Backend (server/) -----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Required. Postgres connection string. Migrations run on boot.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Set to "false" only for local dev (http://localhost rejects Secure cookies).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax
