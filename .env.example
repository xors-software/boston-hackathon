# ----- Frontend (web/) -----
NEXT_PUBLIC_ENVIRONMENT=PRODUCTION
NEXT_PUBLIC_CHAIN_ID='1'
NEXT_PUBLIC_SEGMENT_WRITE_KEY='SEGMENT WRITE KEY HERE'

# Where /api/* rewrites to (Next.js → Elysia).
API_URL=http://localhost:3001

# Cross-origin override. Leave UNSET for normal deploys — same-origin
# proxying via /api keeps xors_session cookie under SameSite=Lax.
# NEXT_PUBLIC_API_URL=

# XORS centralized identity (api.xors.xyz). Required — without these
# /oauth fails with oauth_decrypt. Shared across all XORS consumer apps.
API_AES_KEY=
API_IV_KEY=

# Optional. Override to point at a local api.xors.xyz dev instance.
# XORS_API_URL=

# Registered in apis/common/constants.ts.
NEXT_PUBLIC_XORS_OAUTH_DOMAIN=REDIRECT_BOSTON
XORS_AUTH_SOURCE=boston-hackathon.local

# ----- Backend (server/) -----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Postgres connection. Required — startup fails without it. Run
# `bun run --filter server db:migrate` to apply migrations from
# server/src/db/migrations/.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Set to "false" only for local dev (http://localhost rejects Secure cookies).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax

# Local-dev e2e shortcut. When set, the server treats every request
# as authed by this email — bypasses XORS/Google. Leave UNSET in
# deployed envs.
# TEST_USER_EMAIL=ember-test@example.com
# TEST_USER_NAME=Ember Tester

# OpenAI Whisper for /transcribe (voice → text on recipient + AI screens)
OPENAI_API_KEY=sk-...

# Anthropic Claude for /ai/* (recipient + why AI conversations + summarize)
ANTHROPIC_API_KEY=sk-ant-...

# Transactional email (Resend) — POST /gifts/:id/send delivers the
# invitation. If unset, send still succeeds (recipient row + token are
# persisted) but the email errors and is logged; the giver can retry by
# re-tapping send. Use onboarding@resend.dev as EMAIL_FROM until your
# sending domain is verified.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=gifts@ember.app

# Base URL used when building the invitation link (`{TIME_LOCK_BASE_URL}/r/{token}`).
# Override to http://localhost:3000 for local dev.
TIME_LOCK_BASE_URL=https://ember.app
